# Server
PORT=7870
HOST=0.0.0.0
API_KEYS=123456

# Auth
AUTH_MODE=file
AUTH_DIR=./auth
ENABLE_AUTH_UPDATE=false
AUTH_SYNC_INTERVAL_MS=300000

# AIStudioToAPI (optional, for future HTTP auth sync)
AISTUDIO_BASE_URL=http://aistudio-to-api:7860
AISTUDIO_AUTH_EXPORT_TOKEN=

# Browser
GEMINI_WEB_URL=https://gemini.google.com/app
# chromium keeps existing behavior. firefox is recommended when using auth files generated by AIStudioToAPI/Camoufox.
BROWSER_ENGINE=chromium
BROWSER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=
BROWSER_USER_AGENT=
# Format: WIDTHxHEIGHT, for example 1920x1080
BROWSER_VIEWPORT=
# Optional Playwright proxy server, for example http://127.0.0.1:7890
BROWSER_PROXY=
# Optional init script evaluated before page scripts. Keep empty unless debugging browser fingerprint issues.
BROWSER_INIT_SCRIPT=
AUTH_STATE_WAIT_MS=10000
AUTH_STATE_POLL_MS=500
MAX_CONTEXTS=1
TEMP_CONVERSATION_MODE=true

# Request
MAX_RETRIES=2
RETRY_DELAY_MS=1500
REQUEST_TIMEOUT_MS=120000

# Logging
LOG_LEVEL=info
